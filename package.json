{
  "name": "mirai.lk",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-routes-manifest.js",
    "dev": "next dev",
    "build": "prisma generate --schema ./prisma/schema.prisma && next build",
    "prestart": "node scripts/ensure-routes-manifest.js",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate --schema ./prisma/schema.prisma",
    "generate": "prisma generate --schema ./prisma/schema.prisma",
    "migrate": "npx prisma migrate dev --schema ./prisma/schema.prisma",
    "studio": "npx prisma studio --schema ./prisma/schema.prisma --port 5555"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.81.0",
    "@types/formidable": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.19",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "formidable": "^3.5.1",
    "framer-motion": "^11.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.38.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "critters": "^0.0.23",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "sucrase": {
      "glob": "^14.0.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
