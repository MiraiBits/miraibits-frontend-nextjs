generator client {
  provider = "prisma-client-js"
  output   = "../prisma-products/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_PRODUCT_DB")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  price            Int
  description      String
  shortDescription String
  images           String[]
  stock            Int
  specifications   Json?
  datasheet        String[]
  category         String?
  tags             String[] @default([])

  @@map("products")
}

model Order {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  customerName    String
  customerEmail   String
  customerPhone   String?
  customerAddress String?

  items Json
  total Float

  proofData     String? @db.Text
  proofMimeType String?
  proofFilename String?

  @@map("orders")
}
