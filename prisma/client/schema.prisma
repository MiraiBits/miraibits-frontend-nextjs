generator client {
  provider = "prisma-client-js"
  output   = "../prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  price            Int
  description      String
  shortDescription String
  images           String[]
  stock            Int
  specifications   Json?
  datasheet        String[]
  category         String?
  tags             String[] @default([])

  @@map("products")
}

enum OrderStatus {
  pending
  reviewing_payment
  confirmed_payment
  shipped
  delivered
  payment_failed
  cancelled
}

model Order {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  customerName    String
  customerEmail   String
  customerPhone   String?
  customerAddress String?

  items Json
  total Float

  proofData     String?     @db.Text
  proofMimeType String?
  proofFilename String?
  status        OrderStatus @default(pending)

  @@map("orders")
}
