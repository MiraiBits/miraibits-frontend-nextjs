# Company / Contact (server-side)
COMPANY_NAME="Miraibits"
COMPANY_EMAIL="orders@miraibits.lk"
COMPANY_PHONE="+94 11 234 5678"
COMPANY_ADDRESS="Colombo, Sri Lanka"

# Company / Contact (client-side - for PDF generation)
NEXT_PUBLIC_COMPANY_NAME="Miraibits"
NEXT_PUBLIC_COMPANY_ADDRESS="Colombo, Sri Lanka"

# Email (SMTP) for order notifications (used by lib/email.ts)
# Note: Only the admin is emailed; customers are not CCed.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587" # 465 for SSL
SMTP_USER="smtp_username_or_api_key"
SMTP_PASS="replace_with_smtp_password_or_api_key"
ADMIN_EMAIL="orders@miraibits.lk"

# Resend
RESEND_API_KEY="example-api-key"
COMPANY_EMAIL="orders@miraibits.lk"

# Prisma Database (Accelerate)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"

# Prisma Optimize (Optional - for query performance monitoring)
OPTIMIZE_API_KEY="YOUR_OPTIMIZE_API_KEY_HERE"

# Optional: If you later make metadataBase depend on env
# SITE_URL="https://miraibits.example.com"
